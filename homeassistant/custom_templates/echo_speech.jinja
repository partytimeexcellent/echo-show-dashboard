{#- Spoken forms of entity states, for Assist's voice answers.

  "73.688 °F" becomes "74 degrees", "45.2 %" becomes "45 percent", "1.0 kWh" becomes
  "1 kilowatt hour". Used by custom_sentences/en/echo_responses.yaml; usable from any
  template too:  {% from 'echo_speech.jinja' import say_state %}{{ say_state('sensor.x') }}
-#}

{#- unit -> [singular, plural, decimals]. decimals -1 = whole number from 10 up, else one decimal. -#}
{%- set UNITS = {
  '°F': ['degree', 'degrees', 0], '°C': ['degree', 'degrees', 0], 'K': ['kelvin', 'kelvin', 0],
  '°': ['degree', 'degrees', 0],
  '%': ['percent', 'percent', 0],
  'W': ['watt', 'watts', 0], 'kW': ['kilowatt', 'kilowatts', -1],
  'Wh': ['watt hour', 'watt hours', 0], 'kWh': ['kilowatt hour', 'kilowatt hours', -1],
  'V': ['volt', 'volts', 0], 'mV': ['millivolt', 'millivolts', 0], 'A': ['amp', 'amps', -1], 'mA': ['milliamp', 'milliamps', 0],
  'VA': ['volt amp', 'volt amps', 0], 'Hz': ['hertz', 'hertz', 0], 'kHz': ['kilohertz', 'kilohertz', 0],
  'MHz': ['megahertz', 'megahertz', -1], 'GHz': ['gigahertz', 'gigahertz', -1],
  'lx': ['lux', 'lux', 0], 'lm': ['lumen', 'lumens', 0],
  'ppm': ['part per million', 'parts per million', 0], 'ppb': ['part per billion', 'parts per billion', 0],
  'µg/m³': ['microgram per cubic meter', 'micrograms per cubic meter', 0],
  'mph': ['mile per hour', 'miles per hour', 0], 'km/h': ['kilometer per hour', 'kilometers per hour', 0],
  'm/s': ['meter per second', 'meters per second', -1], 'kn': ['knot', 'knots', 0], 'ft/s': ['foot per second', 'feet per second', 0],
  'inHg': ['inch of mercury', 'inches of mercury', 2], 'hPa': ['hectopascal', 'hectopascals', 0],
  'mbar': ['millibar', 'millibars', 0], 'kPa': ['kilopascal', 'kilopascals', -1], 'psi': ['psi', 'psi', -1],
  'in': ['inch', 'inches', -1], 'mm': ['millimeter', 'millimeters', -1], 'cm': ['centimeter', 'centimeters', -1],
  'ft': ['foot', 'feet', 0], 'm': ['meter', 'meters', -1], 'mi': ['mile', 'miles', -1], 'km': ['kilometer', 'kilometers', -1],
  'in/h': ['inch per hour', 'inches per hour', 2], 'mm/h': ['millimeter per hour', 'millimeters per hour', -1],
  'gal': ['gallon', 'gallons', -1], 'L': ['liter', 'liters', -1], 'mL': ['milliliter', 'milliliters', 0],
  'ft³': ['cubic foot', 'cubic feet', -1], 'm³': ['cubic meter', 'cubic meters', -1],
  'lb': ['pound', 'pounds', -1], 'oz': ['ounce', 'ounces', -1], 'kg': ['kilogram', 'kilograms', -1], 'g': ['gram', 'grams', 0],
  'dB': ['decibel', 'decibels', 0], 'dBm': ['dBm', 'dBm', 0],
  's': ['second', 'seconds', 0], 'min': ['minute', 'minutes', 0], 'h': ['hour', 'hours', -1], 'd': ['day', 'days', 0],
  'ms': ['millisecond', 'milliseconds', 0],
  'kB': ['kilobyte', 'kilobytes', 0], 'MB': ['megabyte', 'megabytes', 0], 'GB': ['gigabyte', 'gigabytes', -1],
  'TB': ['terabyte', 'terabytes', -1], 'GiB': ['gigabyte', 'gigabytes', -1],
  'Mbit/s': ['megabit per second', 'megabits per second', 0], 'kbit/s': ['kilobit per second', 'kilobits per second', 0],
  'MB/s': ['megabyte per second', 'megabytes per second', -1],
  'UV index': ['', '', 0], 'UV': ['', '', 0],
  '$': ['dollar', 'dollars', 2], '¢/kWh': ['cent per kilowatt hour', 'cents per kilowatt hour', -1],
} -%}

{%- set CONDITIONS = {
  'clear': 'clear', 'clear-night': 'clear', 'cloudy': 'cloudy', 'exceptional': 'unusual weather',
  'fog': 'foggy', 'hail': 'hailing', 'lightning': 'with lightning', 'lightning-rainy': 'thunderstorms',
  'partlycloudy': 'partly cloudy', 'pouring': 'pouring', 'rainy': 'raining', 'snowy': 'snowing',
  'snowy-rainy': 'sleeting', 'sunny': 'sunny', 'windy': 'windy', 'windy-variant': 'windy and cloudy',
} -%}

{%- set WORDS = {
  'heat_cool': 'heat and cool', 'fan_only': 'fan only', 'not_home': 'away', 'home': 'home',
  'unavailable': 'unavailable', 'unknown': 'unknown',
} -%}

{#- A number as it should be said: 73.688 -> 74, 2.50 -> 2.5, 0.04 -> 0.04.
    decimals: 0, 1, 2, or -1 (whole from 10 up, one decimal below). -#}
{%- macro say_number(value, decimals=-1) -%}
  {%- set n = value | float(0) -%}
  {%- set d = decimals | int(-1) -%}
  {%- if d < 0 -%}{%- set d = 0 if (n | abs) >= 10 else 1 -%}{%- endif -%}
  {%- set r = n | round(d) -%}
  {%- if r == 0 and n != 0 and d < 2 -%}{%- set r = n | round(2) -%}{%- endif -%}
  {%- if r == (r | int) -%}{{ r | int }}{%- else -%}{{ r }}{%- endif -%}
{%- endmacro -%}

{#- A number with its unit spoken out: (73.688, '°F') -> "74 degrees". -#}
{%- macro say_value(value, unit='') -%}
  {%- set u = (unit or '') | trim -%}
  {%- set spec = UNITS.get(u) -%}
  {%- if spec -%}
    {%- set num = say_number(value, spec[2]) -%}
    {%- set word = spec[0] if (num | float(0)) | abs == 1 else spec[1] -%}
    {{- (num ~ ' ' ~ word) | trim -}}
  {%- else -%}
    {{- (say_number(value) ~ ' ' ~ u) | trim -}}
  {%- endif -%}
{%- endmacro -%}

{#- A whole entity's state, spoken: "74 degrees", "on", "away", "heat and cool". -#}
{%- macro say_state(entity_id) -%}
  {%- set s = states(entity_id) -%}
  {%- if is_number(s) -%}
    {%- set unit = state_attr(entity_id, 'unit_of_measurement') -%}
    {%- if not unit and (state_attr(entity_id, 'device_class') == 'temperature') -%}{%- set unit = '°' -%}{%- endif -%}
    {{- say_value(s, unit) -}}
  {%- elif entity_id.startswith('weather.') -%}
    {{- CONDITIONS.get(s | lower, s | replace('_', ' ')) -}}
  {%- else -%}
    {{- WORDS.get(s, s | replace('_', ' ') | replace('-', ' ')) -}}
  {%- endif -%}
{%- endmacro -%}

{#- The current weather: "69 degrees and clear". -#}
{%- macro say_weather(entity_id) -%}
  {%- set t = state_attr(entity_id, 'temperature') -%}
  {%- set cond = CONDITIONS.get(states(entity_id) | lower, states(entity_id) | replace('_', ' ')) -%}
  {%- set joiner = ' with ' if cond.startswith('with ') else ' and ' -%}
  {%- set cond = cond | replace('with ', '') -%}
  {%- if is_number(t) -%}
    {{- say_value(t, '°') ~ joiner ~ cond -}}
  {%- else -%}
    {{- cond | capitalize -}}
  {%- endif -%}
{%- endmacro -%}

{#- A thermostat's room temperature: "74 degrees". -#}
{%- macro say_climate(entity_id) -%}
  {%- set t = state_attr(entity_id, 'current_temperature') -%}
  {%- if is_number(t) -%}
    {{- say_value(t, '°') -}}
  {%- else -%}
    {{- say_state(entity_id) -}}
  {%- endif -%}
{%- endmacro -%}
