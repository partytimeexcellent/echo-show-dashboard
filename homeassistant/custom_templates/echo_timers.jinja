{#- Echo Show timers: shared helpers for voice parsing and the alarm automation.
    Copy to <config>/custom_templates/echo_timers.jinja, then restart Home Assistant
    (or call the homeassistant.reload_custom_templates action). -#}
{%- macro timer_seconds(text) -%}
{%- set ones = {'zero':0,'one':1,'two':2,'three':3,'four':4,'five':5,'six':6,'seven':7,'eight':8,'nine':9,'ten':10,'eleven':11,'twelve':12,'thirteen':13,'fourteen':14,'fifteen':15,'sixteen':16,'seventeen':17,'eighteen':18,'nineteen':19} -%}
{%- set tens = {'twenty':20,'thirty':30,'forty':40,'fifty':50,'sixty':60,'seventy':70,'eighty':80,'ninety':90} -%}
{%- set t = (text | string | lower | replace('-', ' ') | regex_replace('[,!?]', ' ') | regex_replace('\\.(?!\\d)', ' ')) -%}
{%- set t = t | regex_replace('\\bhalf (an |a )?hour\\b', '30 minutes') -%}
{%- set t = t | regex_replace('\\bhalf (a )?minute\\b', '30 seconds') -%}
{%- set t = t | regex_replace('\\b(a|an)\\s+(hour|hr|minute|min|second|sec)', '1 \\2') -%}
{%- set t = t | regex_replace('\\ba couple( of)?\\b', '2') -%}
{%- set t = t | regex_replace('\\ba few\\b', '3') -%}
{%- set ns = namespace(out=[], acc=none) -%}
{%- for w in t.split() -%}
  {%- if w in tens -%}
    {%- if ns.acc is not none -%}{%- set ns.out = ns.out + [ns.acc | string] -%}{%- endif -%}
    {%- set ns.acc = tens[w] -%}
  {%- elif w in ones -%}
    {%- if ns.acc is not none and ns.acc >= 20 and ns.acc % 10 == 0 and ones[w] < 10 -%}
      {%- set ns.acc = ns.acc + ones[w] -%}
    {%- else -%}
      {%- if ns.acc is not none -%}{%- set ns.out = ns.out + [ns.acc | string] -%}{%- endif -%}
      {%- set ns.acc = ones[w] -%}
    {%- endif -%}
  {%- else -%}
    {%- if ns.acc is not none -%}{%- set ns.out = ns.out + [ns.acc | string] -%}{%- set ns.acc = none -%}{%- endif -%}
    {%- set ns.out = ns.out + [w] -%}
  {%- endif -%}
{%- endfor -%}
{%- if ns.acc is not none -%}{%- set ns.out = ns.out + [ns.acc | string] -%}{%- endif -%}
{%- set t = ns.out | join(' ') -%}
{%- set t = t | regex_replace('(\\d+) (hours?|hrs?|minutes?|mins?) and (a )?half', '\\1.5 \\2') -%}
{%- set t = t | regex_replace('(\\d+) and (a )?half', '\\1.5') -%}
{%- set t = t | regex_replace('(\\d+) and 1 half', '\\1.5') -%}
{%- set t = t | regex_replace('(\\d+)\\s*(1/2)', '\\1.5') -%}
{%- set ns2 = namespace(total=0, found=false) -%}
{%- for m in t | regex_findall('(\\d+(?:\\.\\d+)?)\\s*(hours|hour|hrs|hr|h|minutes|minute|mins|min|m|seconds|second|secs|sec|s)\\b') -%}
  {%- set n = m[0] | float(0) -%}
  {%- set u = m[1] -%}
  {%- set ns2.found = true -%}
  {%- if u.startswith('h') -%}{%- set ns2.total = ns2.total + n * 3600 -%}
  {%- elif u.startswith('s') -%}{%- set ns2.total = ns2.total + n -%}
  {%- else -%}{%- set ns2.total = ns2.total + n * 60 -%}{%- endif -%}
{%- endfor -%}
{%- if not ns2.found -%}
  {%- set bare = t | regex_findall('(\\d+(?:\\.\\d+)?)') -%}
  {%- if bare | count > 0 -%}{%- set ns2.total = (bare[0] | float(0)) * 60 -%}{%- endif -%}
{%- endif -%}
{{- ns2.total | round(0) | int -}}
{%- endmacro -%}

{%- macro clean_name(text) -%}
{%- set n = (text | default('', true) | string | lower | trim) -%}
{%- set n = n | regex_replace('^(the|a|an|my|that|this)(\\s+|$)', '') -%}
{%- set n = n | regex_replace('^(the|a|an|my)(\\s+|$)', '') -%}
{%- set n = n | regex_replace('(^|\\s+)timers?$', '') -%}
{{- n | title -}}
{%- endmacro -%}

{%- macro speak_duration(secs) -%}
{%- set s = secs | float(0) | round(0) | int -%}
{%- set h = s // 3600 -%}{%- set m = (s % 3600) // 60 -%}{%- set r = s % 60 -%}
{%- set parts = [] -%}
{%- if h > 0 -%}{%- set parts = parts + [h ~ (' hour' if h == 1 else ' hours')] -%}{%- endif -%}
{%- if m > 0 -%}{%- set parts = parts + [m ~ (' minute' if m == 1 else ' minutes')] -%}{%- endif -%}
{%- if r > 0 and h == 0 -%}{%- set parts = parts + [r ~ (' second' if r == 1 else ' seconds')] -%}{%- endif -%}
{{- parts | join(' and ') if parts else 'less than a second' -}}
{%- endmacro -%}

{%- macro timer_label(n) -%}
{{- 'your timer' if (n | lower) in ['', 'timer', 'unknown'] else 'the ' ~ (n | lower) ~ ' timer' -}}
{%- endmacro -%}

{%- macro remaining_secs(slot, prefix='echo_timer') -%}
{%- set e = 'timer.' ~ prefix ~ '_' ~ slot -%}
{%- if is_state(e, 'active') -%}{{- [as_timestamp(state_attr(e, 'finishes_at'), 0) - as_timestamp(now()), 0] | max | round(0) | int -}}
{%- elif is_state(e, 'paused') -%}{%- set p = (state_attr(e, 'remaining') | string).split(':') -%}{{- ((p[0] | int(0)) * 3600 + (p[1] | int(0)) * 60 + (p[2] | float(0))) | round(0) | int -}}
{%- else -%}0{%- endif -%}
{%- endmacro -%}

{%- macro slots_json(prefix='echo_timer') -%}
{%- set ns = namespace(l=[]) -%}
{%- for i in [1, 2, 3] -%}
{%- set n = states('input_text.' ~ prefix ~ '_' ~ i ~ '_name') -%}
{%- set s = states('timer.' ~ prefix ~ '_' ~ i) -%}
{%- if s in ['active', 'paused'] or n not in ['', 'unknown', 'unavailable'] -%}
{%- set ns.l = ns.l + [{'i': i, 's': ('done' if s == 'idle' else s), 'n': (n if n not in ['', 'unknown', 'unavailable'] else 'Timer'), 'f': (as_timestamp(state_attr('timer.' ~ prefix ~ '_' ~ i, 'finishes_at'), 0) if s == 'active' else 0)}] -%}
{%- endif -%}
{%- endfor -%}
{{- ns.l | to_json -}}
{%- endmacro -%}

{#- Index (0-based) of the display whose assist satellite heard a voice command.
    displays: the list from the voice blueprint; falls back to the first display. -#}
{%- macro display_index(device_id, displays) -%}
{%- set ents = device_entities(device_id) if device_id else [] -%}
{%- set ns = namespace(i=0, found=false) -%}
{%- for d in displays -%}
{%- if not ns.found and d.satellite is defined and d.satellite in ents -%}{%- set ns.i = loop.index0 -%}{%- set ns.found = true -%}{%- endif -%}
{%- endfor -%}
{{- ns.i -}}
{%- endmacro -%}
